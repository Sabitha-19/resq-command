# Copy this file to .env (or just export these before starting uvicorn).
# None of these are required for the demo to run - they have safe defaults -
# but you should set RESQ_SECRET to something random before a real deployment.

# Used to sign login tokens and hash passwords. Any random string is fine.
RESQ_SECRET=change-me-to-a-random-string

# Where the SQLite database file is written. Defaults to backend/resq.db.
# RESQ_DB_PATH=./resq.db
